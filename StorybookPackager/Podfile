# Uncomment the next line to define a global platform for your project
platform :osx, '10.13'

target 'Storybook Packager' do
  # Comment the next line if you're not using Swift and don't want to use dynamic frameworks
  use_frameworks!

  # Pods for Storybook Packager

  # Storybook+ XML Parser
  pod 'sbplus-xml-parser', :git => 'https://github.com/oel-mediateam/sbplus-xml-parser.git'

  # Software update framework
  pod 'Sparkle'

  # testing for Internet availability
  pod 'ReachabilitySwift', :git => 'https://github.com/ashleymills/Reachability.swift.git'

end
